#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// DaVinci Resolve (macOS default shortcuts). The encoder moves the playhead;
// holding a mode key changes what the encoder does.
#define EDIT 0
#define SECONDS 1
#define ZOOM 2
#define NUDGE 3
#define JUMP 4
#define NUDGE_FAST 5
#define BLUETOOTH 6

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        nudge_fast {
            if-layers = <NUDGE SECONDS>;
            then-layer = <NUDGE_FAST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_edit {
            display-name = "Edit";
            bindings = <
                &kp A          &kp B          &kp T      &kp N
                &kp LG(B)      &kp LS(BSPC)   &kp LG(Z)  &kp LG(LS(Z))
                &mo ZOOM       &mo NUDGE      &mo JUMP   &kp E          &tog BLUETOOTH
                &mo SECONDS    &kp LS(Z)      &kp F18    &kp F19
            >;
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };

        layer_seconds {
            display-name = "Seconds";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp LS(RIGHT) LS(LEFT)>;
        };

        layer_zoom {
            display-name = "Zoom";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp LG(EQUAL) LG(MINUS)>;
        };

        layer_nudge {
            display-name = "Nudge";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp DOT COMMA>;
        };

        layer_jump {
            display-name = "Jump";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        layer_nudge_fast {
            display-name = "Nudge+";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp LS(DOT) LS(COMMA)>;
        };

        layer_bluetooth {
            display-name = "BT";
            bindings = <
                &bt BT_CLR    &none         &none         &bootloader
                &none         &none         &none         &none
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none        &tog BLUETOOTH
                &none         &none         &none         &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
